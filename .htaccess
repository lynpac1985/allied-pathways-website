# Allied Pathways — server config
# Canonical host + protocol, custom 404, baseline security headers

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force https://www.alliedpathways.com.au for every request
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.alliedpathways.com.au%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
